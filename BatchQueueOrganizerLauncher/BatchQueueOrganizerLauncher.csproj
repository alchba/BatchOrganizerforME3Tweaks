<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ME3TweaksBatchQueueOrganizer</AssemblyName>
    <RootNamespace>ME3TweaksBatchQueueOrganizer</RootNamespace>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <InformationalVersion>1.0.3</InformationalVersion>
    <Product>ME3Tweaks Batch Queue Organizer</Product>
    <AssemblyTitle>ME3Tweaks Batch Queue Organizer</AssemblyTitle>
    <Description>Portable organizer for ME3Tweaks Batch Installer queues</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ME3TweaksBatchQueueOrganizer.ico</ApplicationIcon>
    <DefineConstants Condition="'$(EmbedOrganizerAssets)' == 'true'">$(DefineConstants);DISTRIBUTION_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EmbedOrganizerAssets)' == 'true'">
    <EmbeddedResource Include="..\BatchQueueOrganizer.ps1" LogicalName="BatchQueueOrganizer.ps1" />
    <EmbeddedResource Include="ME3TweaksBatchQueueOrganizer.ico" LogicalName="ME3TweaksBatchQueueOrganizer.ico" />
  </ItemGroup>
</Project>
